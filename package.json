  "bin": {
    "codex-history": "./src/cli.js"
  },
  "files": [
    "README.md",
    "README_ZH.md",
    "LICENSE",
    "RELEASE.md",
    "src",
    "scripts",
    "docs",
    "installer",
    "skills"
